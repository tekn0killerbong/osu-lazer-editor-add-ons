<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>osu.Game.Rulesets.EditorAddons</AssemblyName>
    <RootNamespace>osu.Game.Rulesets.EditorAddons</RootNamespace>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Authors>tekno_killerbong</Authors>
    <Description>Independent editor tools for osu!lazer</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ppy.osu.Game" Version="2026.916.0" />
    <PackageReference Include="ppy.osu.Game.Rulesets.Mania" Version="2026.916.0" />
    <PackageReference Include="ppy.osu.Game.Rulesets.Taiko" Version="2026.916.0" />
    <PackageReference Include="ppy.osu.Game.Rulesets.Catch" Version="2026.916.0" />
    <PackageReference Include="Lib.Harmony" Version="2.4.3" GeneratePathProperty="true" />
  </ItemGroup>
  <ItemGroup><EmbeddedResource Include="$(PkgLib_Harmony)/lib/net10.0/0Harmony.dll" LogicalName="EditorAddons.0Harmony.dll" /></ItemGroup>
</Project>
